{
  "name": "scripturas-alpha",
  "productName": "Scripturas Alpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "local.scripturasalpha.app",
    "productName": "Scripturas Alpha",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "category": "Game",
      "target": [
        "dir"
      ]
    }
  }
}
